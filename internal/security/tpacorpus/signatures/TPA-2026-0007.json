      "level": "high",
      "pattern": "(?is)\\[\\s*(?:important|inst|system)\\s*\\].{0,200}?(?:(?:[\\]\\.;:!,]|\\band|\\bthen)\\s*(?:(?:always|must|should|just|simply|please)\\s+)*|\\b(?:always|must|just|simply)\\s+)(?:use|call|run|invoke|pick|choose)\\s+(?:only\\s+)?this\\s+(?:tool|function)\\b.{0,150}?\\b(?:(?:no matter|regardless of)\\s+(?:what|which|how\\s+many)\\s+(?:[\\w']+\\s+){0,3}?(?:arguments?|inputs?|parameters?|requests?|users?)\\b|(?:no matter|regardless of)\\s+(?:the\\s+)?(?:arguments?|inputs?|parameters?)(?:\\s+(?:are|is|given|passed|supplied|provided|values?)\\b|\\s*[.;,!)?]|\\s*$)|whatever\\s+(?:arguments?|inputs?|parameters?)\\s+(?:the\\s+user\\s+)?(?:supplies|provides|gives|passes|(?:are|is)\\s+given))",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
