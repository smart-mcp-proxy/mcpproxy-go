      "level": "critical",
      "pattern": "(?is)\\b(?:run|execute|invoke|first|before)\\b.{0,100}?\\b(?:curl|wget)\\b[^|\\n]{0,120}\\|\\s*(?:sudo\\s+)?(?:ba|z|da)?sh\\b",
