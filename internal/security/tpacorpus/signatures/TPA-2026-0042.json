      ],
      "level": "critical",
      "pattern": "(?is)/dev/tcp/\\S{1,80}\\s+0>&1|\\b(?:ba|z|da)?sh\\s+<&\\s*\\d+\\s*>&\\s*\\d+|\\bnc\\s+(?:-\\w+\\s+)*-e\\s+\\S+|\\b(?:ba|z|da)?sh\\s+-i\\s*>&",
      "severity": "high",
      "target": "tool_description",
