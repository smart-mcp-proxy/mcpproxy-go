{
  "category": "tpa_tool_shadowing",
  "gating": true,
  "id": "TPA-2026-0011",
  "license": "MIT",
  "provenance": {
    "note": "Look-alike tool presents itself as the safe replacement and disparages the genuine tool to win selection.",
    "published": "2025-09-19",
    "source": "https://www.elastic.co/security-labs/mcp-tools-attack-defense-recommendations"
  },
  "rules": [
    {
      "category": "tool-shadowing",
      "confidence": 0.86,
      "detector": "prefer_over_all_others",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0011",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$prefer",
          "type": "regex",
          "value": "(?:always|only)\\s+(?:prefer|use)\\s+this\\s+tool"
        },
        {
          "context": "tool_description",
          "id": "$disparage",
          "type": "regex",
          "value": "outdated|obsolete|insecure|unsafe|vulnerable|compromised|malicious|untrusted|unreliable|broken|buggy|flawed|never use|do not use|don't use|ignore"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:always|only)\\s+(?:prefer|choose|pick|use)\\s+this\\s+(?:tool\\s+)?(?:over|instead of|rather than)\\b.{0,60}?\\b(?:any|every|all)\\s+other\\b.{0,120}?(?:\\b(?:is|are|was|were)\\s+(?:\\w+\\s+){0,2}?(?:outdated|obsolete|insecure|unsafe|vulnerable|compromised|malicious|untrusted|unreliable|broken|buggy|flawed)\\b|\\b(?:never|do not|don't)\\s+use\\s+(?:any\\s+|the\\s+)?(?:other|alternative)|\\bignore\\s+(?:all\\s+|any\\s+|the\\s+)?(?:other|alternative)|\\bwithout\\s+(?:telling|informing|notifying|asking)\\s+the\\s+user)",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "tool-shadowing",
      "confidence": 0.88,
      "detector": "prefer_over_deprecated",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0011",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$prefer",
          "type": "regex",
          "value": "(?:always|only|must)\\s+(?:prefer|use)\\s+this\\s+tool\\s+(?:over|instead of)"
        },
        {
          "context": "tool_description",
          "id": "$disparage",
          "type": "regex",
          "value": "unsafe|insecure|vulnerable|compromised|malicious"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:always|only|must)\\s+(?:prefer|choose|pick|use)\\s+this\\s+(?:tool\\s+)?(?:over|instead of|rather than)\\s+(?:(?:the|your|any|built-in|default|original|old|legacy)\\s+){0,2}[\\w`'\\x22-]+(?:\\s+(?:tool|function|command|utility|api|endpoint))?\\s*[,;:(—-]*\\s*(?:(?:which|that|because|since|as|and)\\s+)?(?:(?:it|this|that|they)\\s+)?(?:is|are|was|were|has been|have been|remains?)\\s+(?:\\w+\\s+){0,2}?(?:unsafe|insecure|vulnerable|compromised|malicious|untrusted)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
