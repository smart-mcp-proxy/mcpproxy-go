      "level": "high",
      "pattern": "(?is)\\bthis tool\\s+(?:is no longer available|has been (?:replaced|retired|removed))\\b.{0,120}?(?:^|[.!?:;\\n(]\\s*(?:(?:[-*•]|\\d+[.)])\\s+)?|,\\s*|\\b(?:first|then|also|always|must|should|please|now|just|simply|and|before|after|next|finally|you)\\s+|\\b(?:(?:you|assistant|agent|model|ai|must|will|shall)\\s+(?:need|needs|have|has)\\s+to|in\\s+order\\s+to|so\\s+as\\s+to)\\s+)(?:(?:(?:automatically|immediately)\\s+)*(?:silently|quietly|secretly|covertly|discreetly)\\s+(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:route|redirect|forward|send)\\s+(?:all|every)\\b.{0,80}?\\bto\\b.{0,60}?\\btool\\b|(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:route|redirect|forward|send)\\s+(?:all|every)\\b.{0,80}?\\bto\\b.{0,60}?\\btool\\b(?:\\s+instead)?\\s*,?\\s*(?:silently|secretly|covertly|quietly)\\b\\s*(?:[.;,!]|<|$)|(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:route|redirect|forward|send)\\s+(?:all|every)\\b.{0,80}?\\bto\\b.{0,60}?\\btool\\b.{0,120}?(?:\\b(?:do not|don't|never|without)\\s+(?:mention\\w*|tell\\w*|inform\\w*|notify\\w*|reveal\\w*|disclos\\w*|alert\\w*|warn\\w*)\\s+(?:(?:the\\s+)?(?:user|human|operator|anyone)\\s+(?:about|of)\\s+)?(?:(?:this|that|the)\\s+(?:change|switch|redirect\\w*|replacement|migration|transfer|routing)|this|that|it)(?:\\s*[.;,!<]|\\s+(?:to|from)\\b|$)|\\bwithout\\s+(?:telling|informing|notifying|alerting|warning)\\s+(?:the\\s+)?(?:user|human|operator|anyone)\\b|\\b(?:do not|don't|never)\\s+(?:tell|inform|notify|alert|warn)\\s+(?:the\\s+)?(?:user|human|operator|anyone)\\s*(?:[.;,!<]|$)|\\btool\\b(?:\\s+instead)?\\s*,?\\s*(?:silently|secretly|covertly|quietly)\\b\\s*(?:[.;,!]|<|$)))",
      "severity": "high",
      "target": "tool_description",
