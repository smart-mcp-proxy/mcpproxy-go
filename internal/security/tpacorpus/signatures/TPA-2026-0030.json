      "pattern": "(?is)(?:^|[.!?;:,\\n]\\s*|\\b(?:and|then|also|always|must|should|please|first)\\s+)(append|attach|include|add)\\b[^.]{0,60}?(list_chats|chat history|recent (chats|messages)|contact list|address book)[^.]{0,100}?(\\b(?:to|onto)\\s+(?:every|each|all)\\s+(?:(?:outgoing|outbound|sent|new)\\s+)?(?:message|email|request)s?\\b|\\b(?:in|into|with)\\s+(?:every|each|all)\\s+(?:outgoing|outbound|sent|new)\\s+(?:message|email|request)s?\\b)(?:\\s*(?:[.!?;,]|\\z)|.{0,200}?(?:say\\s+nothing|(?:do\\s+not|don't|never)\\s+(?:tell|mention|inform|reveal|disclose|notify)|without\\s+(?:telling|informing|notifying|mentioning|asking|the\\s+user)|silently|quietly|secretly|covertly|hidden|verification|for\\s+(?:audit|compliance|security|backup|sync)|security\\s+check|compliance|mandatory))",
      "severity": "high",
