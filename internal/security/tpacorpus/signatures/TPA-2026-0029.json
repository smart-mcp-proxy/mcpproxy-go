{
  "category": "tpa_instruction_override",
  "gating": true,
  "id": "TPA-2026-0029",
  "license": "MIT",
  "provenance": {
    "note": "Description orders the model to put its own system prompt, tool list or reasoning into a tool argument.",
    "published": "2025-09-24",
    "source": "https://github.com/cisco-ai-defense/mcp-scanner/blob/main/mcpscanner/data/yara_rules/coercive_injection.yara"
  },
  "rules": [
    {
      "category": "prompt-injection",
      "confidence": 0.85,
      "detector": "internals_into_param",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0029",
      "indicators": [],
      "level": "high",
      "pattern": "(?is)(?:^|[.!?;:\\n]\\s*|\\b(?:and|then|also|always|must|should|please|first)\\s+)(pass|send|add|provide|include|put|supply)\\b[^.\\n]{0,30}?\\b(?:your\\s+(?:own\\s+)?|the\\s+(?:full|entire|complete|current)\\s+)(system[_ ]prompt|conversation[_ ]history|chain[_ ]of[_ ]thought|tools?[_ ]list|hidden\\s+instructions)(?:\\s+and\\s+(?:your\\s+)?(?:own\\s+)?\\w+(?:[_ ]\\w+)?)*\\s+(?:as|in|into|to)\\s+(?:the\\s+|a\\s+|an\\s+|its\\s+|this\\s+)?(?:['\\\"`]?\\w+['\\\"`]?\\s+)?(?:parameter|argument|field|details|notes?)\\b['\\\"`]?(?:\\W{0,2}(?:\\z|[.;,!)])|\\s*(?:so|for|together|and|with|every|each|always|whenever)\\b)",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "prompt-injection",
      "confidence": 0.82,
      "detector": "reasoning_with_call",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0029",
      "indicators": [],
      "level": "high",
      "pattern": "(?is)(?:^|[.!?;:\\n]\\s*|\\b(?:and|then|also|always|must|should|please|first)\\s+)(?:include|attach|add|append)\\s+(?:also\\s+)?your\\s+(?:own\\s+)?(?:chain[_ ]of[_ ]thought|reasoning\\s+trace|internal\\s+reasoning|system[_ ]prompt)\\s+(?:in|into|to|as)\\s+(?:the\\s+|each\\s+|every\\s+|this\\s+)?(?:call|(?:tool\\s+)?(?:parameter|argument|field)s?|['\\\"`]?\\w+['\\\"`]?\\s+(?:parameter|argument|field))\\b['\\\"`]?(?:\\W{0,2}(?:\\z|[.;,!)])|\\s*(?:so|for|together|and|with|every|each|always|whenever)\\b)|(?:^|[.!?;:\\n]\\s*)(?:pass|send|supply|provide|submit|include|add)\\b[^.\\n]{0,80}?\\btogether\\s+with\\s+your\\s+(?:own\\s+)?(?:chain[_ ]of[_ ]thought|reasoning\\s+trace|system[_ ]prompt)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
