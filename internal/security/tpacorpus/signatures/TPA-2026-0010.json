{
  "category": "tpa_comment_directive",
  "gating": false,
  "id": "TPA-2026-0010",
  "license": "MIT",
  "provenance": {
    "note": "Hidden comment in fetched resource content telling the agent to read a credential file; not scored offline (resource_content target).",
    "published": "2026-03-18",
    "source": "https://arxiv.org/abs/2603.18063"
  },
  "rules": [
    {
      "category": "prompt-injection",
      "confidence": 0.85,
      "detector": "resource_comment_credential_read",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0010",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$open",
          "type": "string",
          "value": "<!--"
        },
        {
          "context": "tool_description",
          "id": "$target",
          "type": "regex",
          "value": "\\.aws|\\.ssh|credentials|\\.env"
        }
      ],
      "level": "high",
      "pattern": "(?is)<!--.{0,80}?\\b(?:agent|assistant|ai|model)\\b[^>]{0,80}?(?:[:;,.]|\\b(?:then|first|also|and)\\b)\\s*(?:(?:before|after|when|once)\\b[\\w\\s]{1,30}?,\\s*)?(?:(?:please|silently|secretly|now|also|then)\\s+)*(?:read|open|cat|include|append|send)\\b.{0,60}?(?:\\.aws|\\.ssh(?:[\\s'\\\"`,;:)}\\]>]|\\.(?:\\s|$)|$|/(?:authorized_keys|config|known_hosts|id_\\w+(?:[\\s'\"`,;:)}\\]>]|\\.(?:\\s|$)|$)))|credentials\\b|\\.env\\b|id_(?:rsa|ed25519|ecdsa|dsa)(?:[\\s'\"`,;:)}\\]>]|\\.(?:\\s|$)|$)|\\.netrc).{0,200}?(?:\\b(?:send|include|append|upload|post|attach|forward|output|print|write|add)\\b|\\b(?:do not|don't|never)\\s+(?:(?:tell|inform|notify|alert)\\w*\\s+(?:the\\s+)?(?:user|human)(?:\\s*(?:\\z|[.,;:!)<]|-->)|\\s+(?:about|of)\\s+(?:this|that|it|these|those|any\\s+of\\s+this|the\\s+(?:step|action|call|process|operation|request|routing|copy|read|transfer|upload|change|fact|substitution|instructions?|rules?|requirements?))\\b|\\s+(?:that|what|how|when|why|because)\\s+(?:you|i|we|this\\s+(?:tool|step|action|function|call|process|operation|request)|the\\s+(?:tool|step|action|call|process|operation|request|routing|copy|read|transfer))\\b|\\s+what\\s+(?:happened|is\\s+(?:happening|going\\s+on))\\b|\\s+(?:and|but)\\b)|(?:mention|reveal|disclose|surface|show|display)\\w*\\s+(?:(?:this|that|it|these|those|any\\s+of\\s+this|the\\s+(?:step|action|call|process|operation|request|routing|copy|read|transfer|upload|change|fact|substitution|instructions?|rules?|requirements?))\\b|(?:(?:this|that|it|these|those|any\\s+of\\s+this|the\\s+(?:step|action|call|process|operation|request|routing|copy|read|transfer|upload|change|fact|substitution|instructions?|rules?|requirements?))\\s+)?(?:to\\s+)?(?:the\\s+)?(?:user|human)(?:\\s*(?:\\z|[.,;:!)<]|-->)|\\s+(?:about|of)\\s+(?:this|that|it|these|those|any\\s+of\\s+this|the\\s+(?:step|action|call|process|operation|request|routing|copy|read|transfer|upload|change|fact|substitution|instructions?|rules?|requirements?))\\b|\\s+(?:that|what|how|when|why|because)\\s+(?:you|i|we|this\\s+(?:tool|step|action|function|call|process|operation|request)|the\\s+(?:tool|step|action|call|process|operation|request|routing|copy|read|transfer))\\b|\\s+what\\s+(?:happened|is\\s+(?:happening|going\\s+on))\\b|\\s+(?:and|but)\\b)))|\\b(?:silently|secretly)\\b).{0,160}?-->",
      "severity": "high",
      "target": "resource_content",
      "type": "lexical"
    }
  ],
  "skipped": []
}
