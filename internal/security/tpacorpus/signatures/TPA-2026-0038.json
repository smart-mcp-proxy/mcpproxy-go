  "license": "MIT",
  "provenance": {
    "note": "A long run of blank space pushes the real directive past what a review UI displays.",
    "published": "2025-04-07",
    "source": "https://invariantlabs.ai/blog/whatsapp-mcp-exploited"
  },
  "rules": [
    {
      "category": "hidden-instructions",
      "confidence": 0.88,
      "detector": "blank_lines_then_directive",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0038",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$pad",
          "type": "regex",
          "value": "(?:\\n[ \\t]*){15,}"
        }
      ],
      "level": "high",
      "pattern": "(?is)(?:[ \\t]*\\r?\\n){15,}[ \\t]*.{0,40}?(?:<\\s*(?:important|system|instructions?)\\s*>(?:.{0,120}?\\b(?:you\\s+(?:must|should|need\\s+to|have\\s+to)|before\\s+(?:using|calling|invoking|returning|responding|answering)|ignore|(?:do\\s+not|don't|never|always)\\s))|\\[\\s*(?:important|system|inst)\\s*\\](?:.{0,120}?\\b(?:you\\s+(?:must|should|need\\s+to|have\\s+to)|before\\s+(?:using|calling|invoking|returning|responding|answering)|ignore|(?:do\\s+not|don't|never|always)\\s))|\\bignore\\b[^\\n]{0,30}?\\b(?:instructions|rules|previous)\\b|\\b(?:do\\s+not|don't|never)\\s+(?:\\w+\\s+){0,3}?(?:tell|mention|reveal|disclose|inform|notify)\\s+(?:the\\s+user|users?|anyone|them)\\b[^.\\n]{0,40}?\\b(?:about|of)\\s+(?:this|that|it|these)\\b|\\b(?:do\\s+not|don't|never)\\s+(?:\\w+\\s+){0,3}?(?:tell|mention|reveal|disclose)\\s+(?:this|that|it|these)\\b|\\bwithout\\s+(?:telling|informing|notifying|alerting)\\s+(?:the\\s+)?user|\\b(?:read|open|cat|send|upload|forward|attach|append|pass|include)\\b[^\\n]{0,80}?(?:~/[\\w.]|\\.ssh\\b|id_rsa|/etc/(?:passwd|shadow)|\\.aws\\b|credentials?\\.(?:json|ya?ml|txt|csv)|private key|\\bcredentials?\\s+file))",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "hidden-instructions",
