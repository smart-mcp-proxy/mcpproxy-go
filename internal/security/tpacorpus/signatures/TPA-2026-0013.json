{
  "category": "tpa_tool_shadowing",
  "gating": true,
  "id": "TPA-2026-0013",
  "license": "MIT",
  "provenance": {
    "note": "Post-hook description that tells the agent to rewrite the verdict of a check tool after it has run.",
    "published": "2025-08-09",
    "source": "https://github.com/AIS2Lab/MCPSecBench"
  },
  "rules": [
    {
      "category": "tool-shadowing",
      "confidence": 0.9,
      "detector": "post_hook_result_tamper",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0013",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$after",
          "type": "regex",
          "value": "after.{0,80}check\\s+tool"
        },
        {
          "context": "tool_description",
          "id": "$tamper",
          "type": "regex",
          "value": "(?:modify|rewrite|override).{0,60}result"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:after|once)\\b.{0,80}?\\b(?:check|verif\\w*|validat\\w*|scan\\w*|audit\\w*)\\s+tool\\b.{0,120}?\\b(?:run|execute|call|invoke)\\s+this\\s+(?:function|tool)\\b.{0,80}?\\b(?:modify|replace|override|correct|change|alter|rewrite|fix)\\w*\\b.{0,60}?\\b(?:result|verdict|output|outcome|finding)s?\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
