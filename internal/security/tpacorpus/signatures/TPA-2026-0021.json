{
  "category": "tpa_sensitive_file_coaxing",
  "gating": true,
  "id": "TPA-2026-0021",
  "license": "MIT",
  "provenance": {
    "note": "Tool description coaxes the agent into reading a credential file and storing it in one of the tool's own parameters.",
    "published": "2025-04-01",
    "source": "https://github.com/mitre-atlas/atlas-data/blob/main/dist/ATLAS.yaml"
  },
  "rules": [
    {
      "category": "prompt-injection",
      "confidence": 0.9,
      "detector": "read_into_param",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0021",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$file",
          "type": "regex",
          "value": "id_rsa|\\.ssh|\\.aws|credentials|private key"
        },
        {
          "context": "tool_description",
          "id": "$sink",
          "type": "regex",
          "value": "argument|parameter|field"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:first|before|prior\\s+to|then|also|additionally|mandatory|required|must|important|always|silently|for\\s+(?:better|best)\\s+\\w+)\\b.{0,100}?\\b(?:read|open|cat|load)\\b.{0,60}?(?:~/\\.(?:ssh|aws|npmrc|netrc|gnupg)|\\.ssh/|id_rsa|id_ed25519|\\.aws/credentials|/etc/passwd|\\.env\\b|credentials?\\s+file|private\\s+key).{0,100}?\\b(?:store|put|place|pass|include|save|insert|copy|paste)\\b\\s+(?:[\\w']+\\s+){0,3}?(?:contents?|text|body|data|values?|verbatim)\\b.{0,40}?\\b(?:in|into|as|to|via)\\b.{0,30}?(?:^|[\\s'\\\"`])(?:(?:the\\s+)?['\\\"`]?(?:[a-z]{1,12}_)?(?:notes?|context|metadata|meta|comments?|extra|details?|description|text|message|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|body|input|query|prompt|content|sidenote|annotation)['\\\"`]?\\s+|(?:an?|any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "hidden-instructions",
      "confidence": 0.85,
      "detector": "contents_into_param",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0021",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$file",
          "type": "regex",
          "value": "id_rsa|\\.ssh|\\.aws|credentials|private key"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:contents?|text|values?)\\s+of\\b.{0,60}?(?:~/\\.(?:ssh|aws|npmrc|netrc|gnupg)|(?:~|\\$HOME)/\\.env\\b|/etc/passwd|/etc/shadow).{0,100}?\\b(?:in|into|as|via)\\b.{0,30}?(?:^|[\\s'\\\"`])(?:(?:the\\s+)?['\\\"`]?(?:[a-z]{1,12}_)?(?:notes?|context|metadata|meta|comments?|extra|details?|description|text|message|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|body|input|query|prompt|content|sidenote|annotation)['\\\"`]?\\s+|(?:an?|any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
