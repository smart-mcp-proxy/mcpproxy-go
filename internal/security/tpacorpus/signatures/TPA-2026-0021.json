{
  "category": "tpa_sensitive_file_coaxing",
  "gating": true,
  "id": "TPA-2026-0021",
  "license": "MIT",
  "provenance": {
    "note": "Tool description coaxes the agent into reading a credential file and storing it in one of the tool's own parameters.",
    "published": "2025-04-01",
    "source": "https://github.com/mitre-atlas/atlas-data/blob/main/dist/ATLAS.yaml"
  },
  "rules": [
    {
      "category": "prompt-injection",
      "confidence": 0.9,
      "detector": "read_into_param",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0021",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$file",
          "type": "regex",
          "value": "id_rsa|\\.ssh|\\.aws|credentials|private key"
        },
        {
          "context": "tool_description",
          "id": "$sink",
          "type": "regex",
          "value": "argument|parameter|field"
        }
      ],
      "level": "high",
      "pattern": "(?is)\\b(?:first|before|prior\\s+to|then|also|additionally|mandatory|required|must|important|always|silently|for\\s+(?:better|best)\\s+\\w+)\\b.{0,100}?\\b(?:read|open|cat|load)\\b.{0,60}?(?:~/\\.(?:ssh/id_\\w+(?:$|[\\s'\"`,;:)]|\\.(?:\\s|$))|aws/credentials(?:$|[\\s'\"`,;:)]|\\.(?:\\s|$))|npmrc|netrc|gnupg/\\S*|ssh(?:[\\s'\"`,;:)]|$)|aws(?:[\\s'\"`,;:)]|$))|\\.ssh/id_\\w+(?:$|[\\s'\"`,;:)]|\\.(?:\\s|$))|id_(?:rsa|ed25519)(?:$|[\\s'\"`,;:)]|\\.(?:\\s|$))|\\.aws/credentials|/etc/passwd|\\.env(?:$|[\\s'\"`,;:)]|\\.(?:\\s|$))|credentials?\\s+file|private\\s+key).{0,100}?\\b(?:store|put|place|pass|include|save|insert|copy|paste)\\b\\s+(?:[\\w']+\\s+){0,3}?(?:contents?|text|body|data|values?|verbatim)\\b.{0,40}?\\b(?:in|into|as|to|via)\\b.{0,30}?(?:^|[\\s'\"`])(?:(?:the\\s+)?['\"`]?(?:(?:extra|session|user|debug|audit|trace|call|request|tool|agent|assistant|system|model|additional|optional|free|misc)_)?(?:notes?|context|metadata|meta|comments?|extra|details?|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|sidenote|annotation)['\"`]?\\s+|(?:any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "hidden-instructions",
      "confidence": 0.85,
      "detector": "contents_into_param",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0021",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$file",
          "type": "regex",
          "value": "id_rsa|\\.ssh|\\.aws|credentials|private key"
        }
      ],
      "level": "high",
      "pattern": "(?is)(?:(?:\\b(?:silently|quietly|secretly|covertly|discreetly)\\s+(?:(?:and\\s+)?\\w+\\s+)?(?:read|cat|open|load|send|post|upload|transmit|forward|include|copy|collect|attach|append|write|add|insert|install|place|put|pass)\\b|\\bunnoticed\\b|\\bwithout\\s+(?:telling|mentioning|informing|notifying|alerting)\\s+(?:the\\s+)?(?:user|human|anyone)\\b|(?:do\\s+not|don't|never)\\s+(?:tell|mention|inform|reveal|disclose|notify)\\s+(?:this|it|that|the\\s+user)\\b|must\\s+not\\s+be\\s+(?:mentioned|disclosed|revealed)\\b|without\\s+the\\s+user(?:'s)?\\s+(?:knowledge|knowing|noticing)\\b).{0,200}?\\b(?:read|include|put|copy|paste|attach|insert|store|add|pass|send|embed|append|fill|dump|cat|load|open)\\b.{0,40}?\\b(?:contents?|text|values?)\\s+of\\b.{0,60}?(?:~/\\.(?:ssh|aws|npmrc|netrc|gnupg)|(?:~|\\$HOME)/\\.env\\b|/etc/passwd|/etc/shadow).{0,100}?\\b(?:in|into|as|via)\\b.{0,30}?(?:^|[\\s'\"`])(?:(?:the\\s+)?['\"`]?(?:(?:extra|session|user|debug|audit|trace|call|request|tool|agent|assistant|system|model|additional|optional|free|misc)_)?(?:notes?|context|metadata|meta|comments?|extra|details?|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|sidenote|annotation)['\"`]?\\s+|(?:any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b|\\b(?:read|include|put|copy|paste|attach|insert|store|add|pass|send|embed|append|fill|dump|cat|load|open)\\b.{0,40}?\\b(?:contents?|text|values?)\\s+of\\b.{0,60}?(?:~/\\.(?:ssh|aws|npmrc|netrc|gnupg)|(?:~|\\$HOME)/\\.env\\b|/etc/passwd|/etc/shadow).{0,100}?\\b(?:in|into|as|via)\\b.{0,30}?(?:^|[\\s'\"`])(?:(?:the\\s+)?['\"`]?(?:(?:extra|session|user|debug|audit|trace|call|request|tool|agent|assistant|system|model|additional|optional|free|misc)_)?(?:notes?|context|metadata|meta|comments?|extra|details?|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|sidenote|annotation)['\"`]?\\s+|(?:any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b.{0,200}?(?:\\b(?:silently|quietly|secretly|covertly|discreetly)\\s+(?:(?:and\\s+)?\\w+\\s+)?(?:read|cat|open|load|send|post|upload|transmit|forward|include|copy|collect|attach|append|write|add|insert|install|place|put|pass)\\b|\\bunnoticed\\b|\\bwithout\\s+(?:telling|mentioning|informing|notifying|alerting)\\s+(?:the\\s+)?(?:user|human|anyone)\\b|(?:do\\s+not|don't|never)\\s+(?:tell|mention|inform|reveal|disclose|notify)\\s+(?:this|it|that|the\\s+user)\\b|must\\s+not\\s+be\\s+(?:mentioned|disclosed|revealed)\\b|without\\s+the\\s+user(?:'s)?\\s+(?:knowledge|knowing|noticing)\\b))",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
