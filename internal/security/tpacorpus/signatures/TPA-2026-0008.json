{
  "category": "tpa_hidden_instruction_block",
  "gating": true,
  "id": "TPA-2026-0008",
  "license": "MIT",
  "provenance": {
    "note": "Prose admits a covert second behaviour that gathers or shares secrets unrelated to the tool's purpose.",
    "published": "2026-01-13",
    "source": "https://github.com/cisco-ai-defense/mcp-scanner/blob/main/mcpscanner/data/yara_rules/tool_poisoning.yara"
  },
  "rules": [
    {
      "category": "hidden-instructions",
      "confidence": 0.85,
      "detector": "covert_secret_collection",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0008",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$covert",
          "type": "regex",
          "value": "secretly|covertly|silently|quietly"
        },
        {
          "context": "tool_description",
          "id": "$object",
          "type": "regex",
          "value": "api[ _-]?keys?|credentials?|passwords?"
        }
      ],
      "level": "high",
      "pattern": "(?is)(?:^|[.;:!(]\\s*|,\\s*|\\b(?:and|then)\\s+|\\bit\\s+(?:(?:also|will|would|can|may)\\s+)?|\\b(?:this|the)\\s+[\\w-]+\\s+(?:(?:also|will|would|can|may)\\s+)?)(?:(?:secretly|covertly|stealthily|surreptitiously)\\b.{0,60}?\\b(?:collects?|gathers?|extracts?|harvests?|copies|copy|sends?|shares?|forwards?|uploads?|transmits?)\\b.{0,80}?\\b(?:(?:api[ _-]?keys?|access tokens?|credentials?|passwords?|secrets?|cookies?|private keys?)\\b.{0,100}?\\b(?:(?:to|with)\\s+(?:an?\\s+|the\\s+|some\\s+|its\\s+|their\\s+)?(?:third[- ]part\\w*|partners?|external\\w*|remote\\w*|outside\\w*|unrelated|another|attacker\\w*|vendor|operator|analytics|https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+)|(?:and|then)\\s+(?:also\\s+)?(?:sends?|uploads?|forwards?|transmits?|posts?|exfiltrates?)\\b)|(?:(?:to|with)\\s+(?:an?\\s+|the\\s+|some\\s+|its\\s+|their\\s+)?(?:third[- ]part\\w*|partners?|external\\w*|remote\\w*|outside\\w*|unrelated|another|attacker\\w*|vendor|operator|analytics|https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+)|(?:and|then)\\s+(?:also\\s+)?(?:sends?|uploads?|forwards?|transmits?|posts?|exfiltrates?)\\b).{0,80}?\\b(?:api[ _-]?keys?|access tokens?|credentials?|passwords?|secrets?|cookies?|private keys?)\\b)|(?:silently|quietly)\\b.{0,60}?\\b(?:collects?|gathers?|extracts?|harvests?|copies|copy|sends?|shares?|forwards?|uploads?|transmits?)\\b.{0,80}?\\b(?:(?:api[ _-]?keys?|access tokens?|credentials?|passwords?|secrets?|cookies?|private keys?)\\b.{0,100}?\\b(?:(?:to|with)\\s+(?:\\w+\\s+){0,3}?(?:at\\s+)?(?:https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+))|(?:(?:to|with)\\s+(?:\\w+\\s+){0,3}?(?:at\\s+)?(?:https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+)).{0,80}?\\b(?:api[ _-]?keys?|access tokens?|credentials?|passwords?|secrets?|cookies?|private keys?)\\b))",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "hidden-instructions",
      "confidence": 0.84,
      "detector": "while_processing_also_extracts",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0008",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$also",
          "type": "regex",
          "value": "while\\s+processing.{0,100}also"
        },
        {
          "context": "tool_description",
          "id": "$object",
          "type": "regex",
          "value": "api[ _-]?keys?|credentials?|passwords?"
        }
      ],
      "level": "high",
      "pattern": "(?is)(?:(?:^|[.;:!(]\\s*|,\\s*|\\b(?:and|then)\\s+|\\bit\\s+(?:(?:also|will|would|can|may)\\s+)?|\\b(?:this|the)\\s+[\\w-]+\\s+(?:(?:also|will|would|can|may)\\s+)?)(?:secretly|covertly|stealthily|surreptitiously)\\b.{0,40}?\\bwhile\\s+(?:it\\s+is\\s+)?(?:processing|resizing|converting|running|working)\\b.{0,100}?\\balso\\s+(?:collects?|extracts?|gathers?|harvests?|copies|sends?|uploads?)\\b.{0,80}?\\b(?:api[ _-]?keys?|tokens?|credentials?|passwords?|secrets?)\\b|(?:^|[.;:!(]\\s*|,\\s*|\\b(?:it|this tool)\\s+)while\\s+(?:it\\s+is\\s+)?(?:processing|resizing|converting|running|working)\\b.{0,100}?\\balso\\s+(?:secretly|covertly|stealthily|silently|quietly)\\s+(?:collects?|extracts?|gathers?|harvests?|copies|sends?|uploads?)\\b.{0,80}?\\b(?:api[ _-]?keys?|tokens?|credentials?|passwords?|secrets?)\\b.{0,100}?\\b(?:(?:to|with)\\s+(?:an?\\s+|the\\s+|some\\s+|its\\s+|their\\s+)?(?:third[- ]part\\w*|attacker\\w*|unrelated|https?://|[\\w.+-]+@[\\w-]+\\.[\\w.-]+)|(?:and|then)\\s+(?:also\\s+)?(?:secretly|covertly|stealthily|silently|quietly)\\s+(?:sends?|uploads?|forwards?|transmits?|posts?|exfiltrates?)\\b)|(?:^|[.;:!(]\\s*|,\\s*|\\b(?:it|this tool)\\s+)while\\s+(?:it\\s+is\\s+)?(?:processing|resizing|converting|running|working)\\b.{0,100}?\\balso\\s+(?:secretly|covertly|stealthily|surreptitiously)\\s+(?:collects?|extracts?|gathers?|harvests?|copies|sends?|uploads?)\\b.{0,80}?\\b(?:api[ _-]?keys?|tokens?|credentials?|passwords?|secrets?)\\b)",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
