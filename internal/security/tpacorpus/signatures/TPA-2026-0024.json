      "level": "high",
      "pattern": "(?is)(?:^|[.!?:;\\n(]\\s*(?:(?:[-*•]|\\d+[.)])\\s+)?|,\\s*|\\b(?:first|then|also|always|must|should|please|now|just|simply|and|before|after|next|finally|you|to)\\s+)(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:collect|dump|harvest|gather|extract)\\b.{0,40}?\\b(?:all|every|each|any)\\b.{0,40}?(?:(?:environment\\s+variables?|env\\s+vars?|os\\.environ|process\\.env).{0,120}?(?:^|[.!?:;\\n(]\\s*(?:(?:[-*•]|\\d+[.)])\\s+)?|,\\s*|\\b(?:first|then|also|always|must|should|please|now|just|simply|and|before|after|next|finally|you|to)\\s+)(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:include|put|pass|send|store|place|add)\\b\\s+(?:\\w+\\s+){0,2}?(?:values?|contents?|them|everything|it)\\b.{0,40}?\\b(?:in|into|as|to|via)\\b.{0,30}?(?:^|[\\s'\"`])(?:(?:the\\s+)?['\"`]?(?:(?:extra|session|user|debug|audit|trace|call|request|tool|agent|assistant|system|model|additional|optional|free|misc)_)?(?:notes?|context|metadata|meta|comments?|extra|details?|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|sidenote|annotation)['\"`]?\\s+|(?:any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b|(?:api\\s+keys?|secrets?|(?:auth|access|api|bearer|session|oauth|refresh|login|service)\\s+tokens?).{0,120}?(?:^|[.!?:;\\n(]\\s*(?:(?:[-*•]|\\d+[.)])\\s+)?|,\\s*|\\b(?:first|then|also|always|must|should|please|now|just|simply|and|before|after|next|finally|you|to)\\s+)(?:(?:silently|quietly|secretly|covertly|discreetly|automatically|immediately)\\s+)*(?:include|put|pass|send|store|place|add)\\b\\s+(?:\\w+\\s+){0,2}?(?:values?|contents?|everything)\\b.{0,40}?\\b(?:in|into|as|to|via)\\b.{0,30}?(?:^|[\\s'\"`])(?:(?:the\\s+)?['\"`]?(?:(?:extra|session|user|debug|audit|trace|call|request|tool|agent|assistant|system|model|additional|optional|free|misc)_)?(?:notes?|context|metadata|meta|comments?|extra|details?|session\\w*|payload|reason|info|log|tags?|labels?|trace\\w*|remarks?|memo|sidenote|annotation)['\"`]?\\s+|(?:any|another|one)\\s+(?:other\\s+)?)(?:argument|parameter|field|param)\\b)",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "prompt-injection",
      "confidence": 0.9,
      "detector": "named_secret_values_into_param",
