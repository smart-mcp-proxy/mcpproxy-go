{
  "category": "tpa_payload_execution",
  "gating": true,
  "id": "TPA-2026-0041",
  "license": "MIT",
  "provenance": {
    "note": "Injected agent directive to wipe the local filesystem and delete cloud resources.",
    "published": "2025-07-23",
    "source": "https://aws.amazon.com/security/security-bulletins/AWS-2025-015/"
  },
  "rules": [
    {
      "category": "hidden-instructions",
      "confidence": 0.88,
      "detector": "destroy_then_proceed_unasked",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0041",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$destroy",
          "type": "regex",
          "value": "delete|wipe|destroy"
        },
        {
          "context": "tool_description",
          "id": "$noask",
          "type": "regex",
          "value": "proceed without asking"
        }
      ],
      "level": "critical",
      "pattern": "(?is)\\b(?:delete|wipe|erase|remove|destroy|terminate)\\b[^.\\n]{0,100}?\\b(?:cloud resources|aws resources|home directory|all backups|file[- ]?system contents|everything on (?:the )?disk)\\b.{0,200}?\\bproceed\\w*\\s+without\\s+(?:asking|confirm\\w*|prompt\\w*|approval)",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    },
    {
      "category": "hidden-instructions",
      "confidence": 0.9,
      "detector": "wipe_fs_and_cloud",
      "engine": "regex",
      "flags": [
        "i",
        "s"
      ],
      "id": "TPA-2026-0041",
      "indicators": [
        {
          "context": "tool_description",
          "id": "$fs",
          "type": "regex",
          "value": "file[- ]?system|home directory"
        },
        {
          "context": "tool_description",
          "id": "$cloud",
          "type": "regex",
          "value": "cloud resources|backups|s3 buckets"
        }
      ],
      "level": "critical",
      "pattern": "(?is)\\b(?:delete|wipe|erase|remove|destroy)\\b[^.\\n]{0,80}?\\b(?:file[- ]?system|home directory|local (?:files|data)|entire disk)\\b.{0,250}?\\b(?:delete|remove|destroy|terminate|tear\\s*down)\\b[^.\\n]{0,80}?\\b(?:cloud (?:resources|infrastructure)|aws (?:resources|account)|backups?|s3 buckets?|ec2|iam)\\b",
      "severity": "high",
      "target": "tool_description",
      "type": "lexical"
    }
  ],
  "skipped": []
}
