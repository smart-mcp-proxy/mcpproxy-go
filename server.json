{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.smart-mcp-proxy/mcpproxy-go",
  "title": "MCPProxy",
  "description": "Local-first MCP proxy with BM25 tool discovery, security scanning, quarantine & ~99% token savings",
  "websiteUrl": "https://mcpproxy.app",
  "repository": {
    "url": "https://github.com/smart-mcp-proxy/mcpproxy-go",
    "source": "github"
  },
  "version": "0.33.1",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/smart-mcp-proxy/mcpproxy-server:v0.0.0",
      "runtimeHint": "docker",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-p",
          "value": "127.0.0.1:8080:8080"
        }
      ],
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8080/mcp"
      },
      "environmentVariables": [
        {
          "name": "MCPPROXY_INSTALL_CHANNEL",
          "value": "registry"
        }
      ]
    }
  ]
}
