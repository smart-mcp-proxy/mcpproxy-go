{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcpproxy.app/schemas/bench-report-v2.schema.json",
  "title": "mcp-discovery-bench report v2",
  "type": "object",
  "required": [
    "report_version",
    "generated_at",
    "tokenizer",
    "corpora",
    "arms",
    "provenance"
  ],
  "properties": {
    "report_version": {
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tokenizer": {
      "type": "object",
      "required": [
        "name",
        "caveat"
      ],
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "cl100k_base"
          ]
        },
        "caveat": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "proxy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "tool_count": {
          "type": "integer"
        },
        "expected_tool_count": {
          "type": "integer"
        },
        "tools_limit": {
          "type": "integer"
        },
        "routing_mode": {
          "type": "string"
        }
      }
    },
    "corpora": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "tool_count",
          "license",
          "committed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tool_count": {
            "type": "integer"
          },
          "license": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "committed": {
            "type": "boolean"
          },
          "degenerate_descriptions": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "arms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arm",
          "corpus_id",
          "skipped"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "skipped": {
                  "const": false
                }
              }
            },
            "then": {
              "required": [
                "index_altering",
                "total_tokens",
                "mean_tokens",
                "p95_tokens",
                "savings_vs_baseline_pct",
                "skipped_tools"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "skipped": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "skip_reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "payload_class": {
                  "const": "results"
                }
              },
              "required": [
                "payload_class"
              ]
            },
            "then": {
              "required": [
                "fixture_id",
                "tabular_count",
                "non_tabular_count"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "index_altering": {
                  "const": true
                },
                "skipped": {
                  "const": false
                }
              },
              "required": [
                "index_altering"
              ]
            },
            "then": {
              "required": [
                "quality"
              ],
              "$comment": "quality is nullable only when the corpus has no relevance labels; metric_note must then explain the absence (enforced by the Go report validator)"
            }
          }
        ],
        "properties": {
          "arm": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "corpus_id": {
            "type": "string"
          },
          "skipped": {
            "type": "boolean"
          },
          "skip_reason": {
            "type": "string"
          },
          "lower_bound": {
            "type": "boolean"
          },
          "index_altering": {
            "type": "boolean"
          },
          "payload_class": {
            "enum": [
              "listing",
              "results"
            ]
          },
          "fixture_id": {
            "type": "string"
          },
          "tabular_count": {
            "type": "integer"
          },
          "non_tabular_count": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "mean_tokens": {
            "type": "number"
          },
          "p95_tokens": {
            "type": "integer"
          },
          "savings_vs_baseline_pct": {
            "type": "number"
          },
          "skipped_tools": {
            "type": "integer"
          },
          "skip_examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool_id": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "heaviest_tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool_id": {
                  "type": "string"
                },
                "tokens": {
                  "type": "integer"
                }
              }
            }
          },
          "quality": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "recall_at_1": {
                "type": "number"
              },
              "recall_at_3": {
                "type": "number"
              },
              "recall_at_5": {
                "type": "number"
              },
              "recall_at_10": {
                "type": "number"
              },
              "mrr": {
                "type": "number"
              },
              "ndcg_at_10": {
                "type": "number"
              },
              "map": {
                "type": "number"
              },
              "metric_note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "response_cost": {
      "type": "object",
      "properties": {
        "p50": {
          "type": "integer"
        },
        "p95": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "mean": {
          "type": "number"
        },
        "per_query": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "query_id",
              "total_tokens",
              "components"
            ],
            "properties": {
              "query_id": {
                "type": "string"
              },
              "total_tokens": {
                "type": "integer"
              },
              "result_count": {
                "type": "integer"
              },
              "latency_ms": {
                "type": "number"
              },
              "components": {
                "type": "object",
                "required": [
                  "input_schemas",
                  "descriptions",
                  "usage_instructions",
                  "metadata",
                  "other"
                ],
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "break_even": {
      "type": "object",
      "properties": {
        "naive_full_menu_tokens": {
          "type": "integer"
        },
        "proxy_menu_tokens": {
          "type": "integer"
        },
        "mean_response_tokens": {
          "type": "number"
        },
        "break_even_calls": {
          "type": "number"
        },
        "no_break_even": {
          "type": "boolean"
        }
      }
    },
    "session_estimates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "arm",
          "calls_per_session",
          "retry_rate",
          "estimated_tokens"
        ],
        "properties": {
          "arm": {
            "type": "string"
          },
          "calls_per_session": {
            "type": "integer"
          },
          "retry_rate": {
            "type": "number"
          },
          "estimated_tokens": {
            "type": "integer"
          }
        }
      }
    },
    "latency": {
      "type": "object",
      "description": "Client-measured latency (FR-023). Two distinct surfaces, never conflated: the flat p50_ms..max_ms fields summarize the REST GET /api/v1/index/search calls (kept for backward compatibility; mirrored in rest_search), while mcp_discovery aggregates the MCP retrieve_tools calls timed by the discovery-response rows.",
      "properties": {
        "p50_ms": {
          "type": "number"
        },
        "p95_ms": {
          "type": "number"
        },
        "p99_ms": {
          "type": "number"
        },
        "max_ms": {
          "type": "number"
        },
        "rest_search": {
          "$ref": "#/$defs/latency_aggregate"
        },
        "mcp_discovery": {
          "$ref": "#/$defs/latency_aggregate"
        }
      }
    },
    "lap": {
      "type": "object",
      "required": [
        "executed"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "skip_reason": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "menu_tokens": {
          "type": "integer"
        },
        "in_house_menu_tokens": {
          "type": "integer"
        },
        "divergence_pct": {
          "type": "number"
        },
        "grade": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string"
        }
      }
    },
    "subset": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        }
      }
    },
    "replay": {
      "type": "object",
      "description": "Spec 103 US1: deterministic cost recomputation over a real recorded workload. Additive and optional — its presence does not change report_version, and it names its OWN accounting source rather than inheriting the document-level tokenizer.",
      "required": [
        "accounting_source",
        "counterfactual",
        "bodies_included",
        "fleet_shape",
        "sessions_supplied",
        "sessions_used"
      ],
      "properties": {
        "accounting_source": {
          "$ref": "#/$defs/accounting_source"
        },
        "counterfactual": {
          "type": "string",
          "minLength": 10,
          "$comment": "FR-004: replay is a counterfactual over recorded traffic scored against the SUPPLIED fleet, never observed agent behaviour. Required so a figure cannot be emitted without its label."
        },
        "bodies_included": {
          "type": "boolean"
        },
        "sensitive_flag_best_effort": {
          "type": "boolean"
        },
        "fleet_shape": {
          "$ref": "#/$defs/fleet_shape"
        },
        "sessions_supplied": {
          "type": "integer"
        },
        "sessions_used": {
          "type": "integer"
        },
        "exclusions": {
          "type": "array",
          "$comment": "FR-003 / SC-008: supplied minus used is explained here, one count per reason. Silence is never success.",
          "items": {
            "type": "object",
            "required": [
              "reason",
              "sessions"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "truncated",
                  "bodies_missing",
                  "sensitive",
                  "unreplayable",
                  "unattributed"
                ]
              },
              "sessions": {
                "type": "integer"
              }
            }
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cell_id",
              "provenance",
              "calls",
              "menu_tokens"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "absolute_workload_withheld": {
                      "const": true
                    }
                  },
                  "required": [
                    "absolute_workload_withheld"
                  ]
                },
                "then": {
                  "required": [
                    "withheld_reason"
                  ],
                  "$comment": "An unavailable absolute workload figure is reported as withheld WITH a reason, never as zero."
                }
              }
            ],
            "properties": {
              "cell_id": {
                "type": "string"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "calls": {
                "type": "integer"
              },
              "menu_tokens": {
                "type": "integer"
              },
              "response_tokens": {
                "type": "integer"
              },
              "absolute_workload_withheld": {
                "type": "boolean"
              },
              "withheld_reason": {
                "type": "string"
              }
            }
          }
        },
        "direct_delta": {
          "type": "object",
          "description": "The cross-mode delta between the two direct cells, whose identical call responses cancel out of the comparison — the honest bodies-off headline.",
          "required": [
            "from_cell_id",
            "to_cell_id",
            "provenance",
            "delta_tokens",
            "delta_pct"
          ],
          "properties": {
            "from_cell_id": {
              "type": "string"
            },
            "to_cell_id": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            },
            "delta_tokens": {
              "type": "integer"
            },
            "delta_pct": {
              "type": "number"
            }
          }
        },
        "loader_accounting": {
          "type": "object",
          "description": "Spec 103 US1: the LOADER's own exclusion accounting, distinct from the session-level `exclusions` array. Session rows answer how many units of work did not get in; these answer what was dropped, suppressed or flagged INSIDE the units that did. A withheld cost collapses a cell's response total, and without a row naming the cause the reader sees a missing figure with no explanation — the silent accounting SC-008 forbids.",
          "required": [
            "records_dropped",
            "costs_withheld",
            "records_flagged"
          ],
          "properties": {
            "records_dropped": {
              "type": "integer",
              "minimum": 0,
              "$comment": "Records that never joined a unit of work."
            },
            "dropped": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "reason",
                  "count"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "costs_withheld": {
              "type": "integer",
              "minimum": 0,
              "$comment": "Costs suppressed on records that DID contribute. Separate from dropped on purpose: merging them yields an uninterpretable total."
            },
            "withheld": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "reason",
                  "count"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "records_flagged": {
              "type": "integer",
              "minimum": 0,
              "$comment": "Records counted in the workload but carrying a usability caveat."
            },
            "flagged": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "reason",
                  "count"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "orphaned_sub_calls": {
              "type": "integer",
              "minimum": 0,
              "$comment": "Sub-calls whose parent fell outside the exported window. Counted in the workload at top level; what was lost is the attribution, and a total that hides it cannot be audited."
            }
          }
        }
      }
    },
    "agent_loop": {
      "type": "object",
      "description": "Spec 103 US2: live agent-loop measurements. Its accounting_source is provider-reported usage plus a pinned model, and its figures are NEVER summed with tokenizer-sourced ones.",
      "required": [
        "accounting_source",
        "fleet_shape"
      ],
      "properties": {
        "accounting_source": {
          "$ref": "#/$defs/accounting_source"
        },
        "suite": {
          "type": "string"
        },
        "suite_version": {
          "type": "string"
        },
        "fleet_shape": {
          "$ref": "#/$defs/fleet_shape"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cell_id",
              "provenance",
              "runs",
              "spread_pct",
              "tokens_per_completed_task",
              "completion_rate_pct",
              "first_attempt_success_pct",
              "retries_corrective",
              "retries_infrastructure",
              "input_tokens",
              "output_tokens",
              "cache_read_tokens",
              "headline"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "headline": {
                      "const": true
                    }
                  },
                  "required": [
                    "headline"
                  ]
                },
                "then": {
                  "properties": {
                    "runs": {
                      "minimum": 4
                    }
                  },
                  "$comment": "FR-021: a model-dependent figure needs at least four runs plus a spread before it may be a headline."
                }
              }
            ],
            "properties": {
              "cell_id": {
                "type": "string"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "runs": {
                "type": "integer"
              },
              "spread_pct": {
                "type": "number"
              },
              "partial_runs": {
                "type": "integer"
              },
              "tokens_per_completed_task": {
                "type": "number"
              },
              "completion_rate_pct": {
                "type": "number"
              },
              "first_attempt_success_pct": {
                "type": "number"
              },
              "retries_corrective": {
                "type": "integer"
              },
              "retries_infrastructure": {
                "type": "integer"
              },
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              },
              "cache_read_tokens": {
                "type": "integer"
              },
              "headline": {
                "type": "boolean"
              },
              "regression": {
                "type": "boolean"
              },
              "withheld": {
                "type": "boolean"
              },
              "withheld_reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "payload_decomposition": {
      "type": "object",
      "description": "Spec 103 US4: tool-definition payload attribution per fleet shape, each with its own recomputed ceiling and an explicit verdict on spec 102.",
      "required": [
        "accounting_source",
        "shapes"
      ],
      "properties": {
        "accounting_source": {
          "$ref": "#/$defs/accounting_source"
        },
        "shapes": {
          "type": "array",
          "minItems": 2,
          "$comment": "FR-024: at least two fleet shapes. A single-shape decomposition is exactly the projection spec 102 got wrong.",
          "items": {
            "type": "object",
            "required": [
              "fleet_shape",
              "provenance",
              "share_names_pct",
              "share_descriptions_pct",
              "share_annotations_pct",
              "share_schemas_pct",
              "achievable_ceiling_pct",
              "spec102_verdict"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "spec102_verdict": {
                      "const": "corrected"
                    }
                  },
                  "required": [
                    "spec102_verdict"
                  ]
                },
                "then": {
                  "required": [
                    "spec102_delta_pct"
                  ],
                  "$comment": "FR-025: a correction states its delta."
                }
              }
            ],
            "properties": {
              "fleet_shape": {
                "$ref": "#/$defs/fleet_shape"
              },
              "provenance": {
                "$ref": "#/$defs/provenance"
              },
              "share_names_pct": {
                "type": "number"
              },
              "share_descriptions_pct": {
                "type": "number"
              },
              "share_annotations_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "$comment": "NULL means the annotation share was not measurable from this corpus shape, which is different from zero. The frozen corpora carry no annotations field, while spec 102 measured the production wire payload that does. Emitting 0 would read as 'measured, and annotations cost nothing' — the silent-zero failure the exclusion accounting exists to prevent."
              },
              "share_schemas_pct": {
                "type": "number"
              },
              "achievable_ceiling_pct": {
                "type": "number",
                "$comment": "Recomputed per fleet shape — never carried forward from a previously published figure."
              },
              "spec102_verdict": {
                "enum": [
                  "confirmed",
                  "corrected"
                ]
              },
              "spec102_delta_pct": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "$comment": "SECTION-level provenance: one badge per section key. It cannot express FR-013, where measured and estimated figures coexist inside one block — that is what the per-row provenance fields on the spec 103 blocks are for.",
      "additionalProperties": {
        "$ref": "#/$defs/provenance"
      }
    }
  },
  "$defs": {
    "provenance": {
      "enum": [
        "measured",
        "computed",
        "estimated"
      ],
      "description": "How a figure was arrived at: measured (observed over the real protocol), computed (arithmetic over measured inputs), or estimated (a model with documented assumptions). Declared once and referenced by both the section-level map and every per-row provenance field, so the two can never drift apart."
    },
    "accounting_source": {
      "type": "object",
      "description": "Where one block's numbers came from. Per BLOCK, because the document-level tokenizer field names the deterministic estimator for the whole report and cannot be narrowed without a report_version bump. Figures from different sources are never summed — a cross-source aggregate is withheld with a stated reason.",
      "required": [
        "kind",
        "identity"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provider-usage"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "model"
            ],
            "$comment": "Provider-reported usage is uninterpretable without the model pinned: an unpinned run is not comparable to any later one."
          }
        }
      ],
      "properties": {
        "kind": {
          "enum": [
            "deterministic-tokenizer",
            "provider-usage"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "cl100k_base",
            "anthropic"
          ]
        },
        "model": {
          "type": "string"
        }
      }
    },
    "fleet_shape": {
      "type": "object",
      "description": "The tool count and definition-size distribution a figure holds for (IC-004). Every published percentage carries one.",
      "required": [
        "id",
        "tool_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tool_count": {
          "type": "integer"
        },
        "mean_definition_tokens": {
          "type": "number"
        },
        "p95_definition_tokens": {
          "type": "integer"
        },
        "schemaless_tools": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Tools in this fleet carrying no priceable input schema. A fleet is refused only when NO tool has a real schema; a PARTIAL regression passes that guard, prices the stubbed tools at nothing and inflates the headline. This count is the only trace such a regression leaves."
        }
      }
    },
    "latency_aggregate": {
      "type": "object",
