exports[`Connect screen: choice of how the client signs in (Spec 132 PR-3) > feature off > renders exactly the screen it rendered before (closed row) 1`] = `
"<dialog class="modal" data-test="client-connect-list" open="">
  <div class="modal-box max-w-lg">
    <h3 class="font-bold text-lg mb-2">Connect MCPProxy to AI Agents</h3>
    <p class="text-sm opacity-70 mb-4"> Register MCPProxy as an MCP server in your AI tools. Clicking a client shows the exact change first — nothing is written until you confirm (backup created automatically). </p>
    <div class="space-y-2">
      <div data-test="client-row-claude-code" class="rounded-lg border border-base-300 hover:bg-base-200/50 transition-colors overflow-hidden">
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-8 h-8 flex items-center justify-center text-lg shrink-0" title="Claude Code" data-test="client-icon-claude-code">💻</div>
            <div class="min-w-0 flex-1">
              <div class="font-medium text-sm truncate">Claude Code
              </div>
              <div class="text-xs opacity-50 truncate" title="/Users/test/.claude.json" data-test="client-path-claude-code">~/.claude.json</div>
            </div>
          </div>
          <div class="shrink-0 ml-2 flex flex-col items-end gap-1"><button data-test="connect-claude-code" class="btn btn-primary btn-xs"><span>Review &amp; connect</span></button>
            <button data-test="connect-check-access" class="btn btn-ghost btn-2xs h-auto min-h-0 py-0.5 text-[0.7rem] opacity-60 hover:opacity-100" title="Read this client's config now to verify access (may prompt on macOS)"><span>Check access</span></button>
          </div>
        </div>
      </div>
      <div data-test="client-row-cursor" class="rounded-lg border border-base-300 hover:bg-base-200/50 transition-colors overflow-hidden">
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-8 h-8 flex items-center justify-center text-lg shrink-0" title="Cursor" data-test="client-icon-cursor">📝</div>
            <div class="min-w-0 flex-1">
              <div class="font-medium text-sm truncate">Cursor
              </div>
              <div class="text-xs opacity-50 truncate" title="/Users/test/.cursor/mcp.json" data-test="client-path-cursor">~/.cursor/mcp.json</div>
            </div>
          </div>
          <div class="shrink-0 ml-2 flex flex-col items-end gap-1"><button data-test="connect-cursor" class="btn btn-primary btn-xs"><span>Review &amp; connect</span></button>
            <button data-test="connect-check-access" class="btn btn-ghost btn-2xs h-auto min-h-0 py-0.5 text-[0.7rem] opacity-60 hover:opacity-100" title="Read this client's config now to verify access (may prompt on macOS)"><span>Check access</span></button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-action items-center">
      <button class="btn btn-primary btn-sm" data-test="connect-all" title="">Connect 2 clients</button><button class="btn btn-ghost btn-sm">Close</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>"
`;

exports[`Connect screen: choice of how the client signs in (Spec 132 PR-3) > feature off > renders exactly the screen it rendered before (preview open) and sends the same requests 1`] = `
"<dialog class="modal" data-test="client-connect-list" open="">
  <div class="modal-box max-w-lg">
    <h3 class="font-bold text-lg mb-2">Connect MCPProxy to AI Agents</h3>
    <p class="text-sm opacity-70 mb-4"> Register MCPProxy as an MCP server in your AI tools. Clicking a client shows the exact change first — nothing is written until you confirm (backup created automatically). </p>
    <div class="space-y-2">
      <div data-test="client-row-claude-code" class="rounded-lg border border-base-300 hover:bg-base-200/50 transition-colors overflow-hidden">
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-8 h-8 flex items-center justify-center text-lg shrink-0" title="Claude Code" data-test="client-icon-claude-code">💻</div>
            <div class="min-w-0 flex-1">
              <div class="font-medium text-sm truncate">Claude Code
              </div>
              <div class="text-xs opacity-50 truncate" title="/Users/test/.claude.json" data-test="client-path-claude-code">~/.claude.json</div>
            </div>
          </div>
          <div class="shrink-0 ml-2 flex flex-col items-end gap-1"><button data-test="connect-claude-code" class="btn btn-primary btn-xs"><span>Review &amp; connect</span></button>
            <button data-test="connect-check-access" class="btn btn-ghost btn-2xs h-auto min-h-0 py-0.5 text-[0.7rem] opacity-60 hover:opacity-100" title="Read this client's config now to verify access (may prompt on macOS)"><span>Check access</span></button>
          </div>
        </div>
        <div data-test="client-preview-claude-code" class="border-t border-base-300 bg-base-200/40 px-3 py-3 space-y-2">
          <p class="text-xs opacity-70 leading-relaxed"> Only this entry is added to <code class="font-mono text-[11px] break-all" title="/Users/test/.claude.json">/Users/test/.claude.json</code>. Everything else in the file stays untouched, and a timestamped backup is created first. </p>
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-wider text-success/80 mb-1">+ will be added</div><pre data-test="client-preview-entry-claude-code" class="text-[11px] font-mono whitespace-pre-wrap break-all rounded bg-base-300/60 border-l-2 border-success px-2 py-1.5 leading-relaxed">{"mcpproxy":{"type":"http","url":"http://127.0.0.1:8080/mcp","headers":{"X-API-Key":"mcp_cli_••••"}}}</pre>
          </div>
          <div class="space-y-2" data-test="client-preview-credential-claude-code">
            <p class="text-xs leading-relaxed" data-test="connect-credential-notice-claude-code"> MCPProxy writes a client credential for Claude Code. The admin API key is never written. </p>
            <p class="text-xs font-mono opacity-80" data-test="connect-credential-claude-code"> Credential: mcp_cli_•••• (client credential) </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 items-end">
              <div class="form-control"><label class="label py-0" for="connect-profile-claude-code"><span class="label-text text-xs font-medium">Profile</span></label><select id="connect-profile-claude-code" class="select select-bordered select-xs w-full" data-test="connect-profile-select-claude-code">
                  <option value="">All servers</option>
                </select></div><label class="label cursor-pointer justify-start gap-2 py-0" title="Choose a profile to lock"><input type="checkbox" role="switch" class="toggle toggle-xs" disabled="" aria-label="Lock Claude Code to this profile" data-test="connect-lock-switch-claude-code"><span class="label-text text-xs">Locked</span></label>
            </div>
            <p class="text-[11px] opacity-70" data-test="connect-binding-summary-claude-code"> Profile: All servers · Mode: switchable</p>
            <p class="text-xs text-warning leading-relaxed" data-test="connect-mgmt-notice-claude-code">This client can no longer add, change or restart servers; manage servers from the Web UI, the macOS app or the CLI</p>
          </div>
          <div class="flex items-center gap-2 pt-1"><button data-test="client-preview-confirm-claude-code" class="btn btn-primary btn-xs"><span>Connect</span></button><button data-test="client-preview-cancel-claude-code" class="btn btn-ghost btn-xs"> Cancel </button></div>
        </div>
      </div>
      <div data-test="client-row-cursor" class="rounded-lg border border-base-300 hover:bg-base-200/50 transition-colors overflow-hidden">
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-3 min-w-0 flex-1">
            <div class="w-8 h-8 flex items-center justify-center text-lg shrink-0" title="Cursor" data-test="client-icon-cursor">📝</div>
            <div class="min-w-0 flex-1">
              <div class="font-medium text-sm truncate">Cursor
              </div>
              <div class="text-xs opacity-50 truncate" title="/Users/test/.cursor/mcp.json" data-test="client-path-cursor">~/.cursor/mcp.json</div>
            </div>
          </div>
          <div class="shrink-0 ml-2 flex flex-col items-end gap-1"><button data-test="connect-cursor" class="btn btn-primary btn-xs"><span>Review &amp; connect</span></button>
            <button data-test="connect-check-access" class="btn btn-ghost btn-2xs h-auto min-h-0 py-0.5 text-[0.7rem] opacity-60 hover:opacity-100" title="Read this client's config now to verify access (may prompt on macOS)"><span>Check access</span></button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-action items-center">
      <button class="btn btn-primary btn-sm" data-test="connect-all" title="">Connect 2 clients</button><button class="btn btn-ghost btn-sm">Close</button>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>"
`;
