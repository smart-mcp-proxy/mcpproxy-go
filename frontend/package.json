{
  "name": "mcpproxy-frontend",
  "version": "1.0.0",
  "description": "MCPProxy Web Control Panel - Vue 3 + TypeScript + DaisyUI",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "echo 'Linting skipped - ESLint config needs migration to flat config format'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcpproxy",
    "vue",
    "typescript",
    "daisyui",
    "control-panel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.5.5",
    "chart.js": "^4.5.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.22",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "brace-expansion": "^5.0.9",
    "minimatch": "^10.0.3"
  }
}
